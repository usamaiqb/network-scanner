    <!-- Dialogue -->
    <string name="dialog_clear_cache_title">Vider le cache ?</string>
    <string name="dialog_clear_cache_message">Cela supprimera toutes les données d’analyse temporaires. Votre historique d’appareils sera conservé.</string>
    <string name="dialog_clear_history_title">Effacer l’historique des appareils ?</string>
    <string name="dialog_clear_history_message">Cela supprimera toutes les informations d’appareil enregistrées, y compris les noms personnalisés. Cette action est irréversible.</string>
    <string name="dialog_about_title">À propos de Network Scanner</string>
    <string name="dialog_about_message" formatted="false">Network Scanner est un outil puissant pour détecter et analyser les appareils de votre réseau local.\n\nConçu en respectant votre vie privée. Toute l’analyse se fait localement sur votre appareil.\n\n⚠️ Note : la découverte d’appareils et le scan de ports ne sont pas précis à 100 %. Les résultats peuvent varier selon les conditions du réseau et la configuration des appareils.\n\nLicence GPL-3.0</string>
    <string name="view_on_github">Voir sur GitHub</string>
    <string name="github_url">https://github.com/usamaiqb/network-scanner</string>
    <string name="deep_scan_disclaimer">La détection de ports et de systèmes d’exploitation est estimative et peut ne pas être totalement précise</string>
    <string name="dialog_privacy_title">Politique de confidentialité</string>
    <string name="dialog_privacy_message">Network Scanner respecte votre vie privée :\n\n• Aucun enregistrement de données : tous les résultats d’analyse restent sur votre appareil\n• Aucune publicité et aucun suivi\n• Aucun accès Internet n’est requis pour l’analyse\n\nL’autorisation de localisation n’est utilisée que pour accéder aux informations Wi‑Fi, comme l’exige Android, et non pour suivre votre position.</string>
    <string name="dialog_theme_restart_title">Thème modifié</string>
    <string name="dialog_theme_restart_message">Les modifications des couleurs dynamiques prendront pleinement effet après le redémarrage de l’application.</string>


    <!-- Dialogs -->
    <string name="dialog_clear_cache_title">Golești memoria cache?</string>
    <string name="dialog_clear_cache_message">Această acțiune va șterge toate datele temporare ale scanărilor. Istoricul dispozitivelor va fi păstrat.</string>
    <string name="dialog_clear_history_title">Ștergi istoricul dispozitivelor?</string>
    <string name="dialog_clear_history_message">Această acțiune va elimina toate informațiile salvate despre dispozitive, inclusiv numele personalizate. Acțiunea nu poate fi anulată.</string>
    <string name="dialog_about_title">Despre Network Scanner</string>
    <string name="dialog_about_message" formatted="false">Network Scanner este un instrument puternic pentru descoperirea și analizarea dispozitivelor din rețeaua ta locală.\n\nDezvoltat cu grijă pentru confidențialitatea ta. Toate scanările au loc local, pe dispozitivul tău.\n\n⚠️ Notă: Detectarea dispozitivelor și scanarea porturilor nu sunt 100% precise. Rezultatele pot varia în funcție de condițiile rețelei și de configurațiile dispozitivelor.\n\nLicență GPL-3.0</string>
    <string name="view_on_github">Vezi pe GitHub</string>
    <string name="github_url">https://github.com/usamaiqb/network-scanner</string>
    <string name="deep_scan_disclaimer">Detectarea porturilor și a sistemului de operare este estimativă și poate să nu fie complet precisă</string>
    <string name="dialog_privacy_title">Politica de confidențialitate</string>
    <string name="dialog_privacy_message">Network Scanner îți respectă confidențialitatea:\n\n• Nu se colectează date: toate rezultatele scanărilor rămân pe dispozitivul tău\n• Fără reclame sau urmărire\n• Scanarea nu necesită permisiune de acces la internet\n\nPermisiunea de acces la locație este folosită doar pentru a accesa informațiile Wi-Fi, conform cerințelor Android, nu pentru a-ți urmări locația.</string>
    <string name="dialog_theme_restart_title">Tema a fost schimbată</string>
    <string name="dialog_theme_restart_message">Modificările culorilor dinamice vor fi aplicate complet după repornirea aplicației.</string>

